# Database
POSTGRES_DB=lore_studio
POSTGRES_USER=lore
POSTGRES_PASSWORD=lore
DATABASE_URL=postgresql+psycopg://lore:lore@db:5432/lore_studio

# API
APP_NAME=Lore Studio
APP_ENV=development
APP_CONFIG_ROOT=/app/config
CORS_ORIGINS=http://localhost:5173

# Local OpenAI-compatible model server
# Keep true until a model endpoint is ready.
MOCK_MODEL=true
MODEL_BASE_URL=http://host.docker.internal:8001/v1
MODEL_API_KEY=local
MODEL_NAME=local-writer
MODEL_TIMEOUT_SECONDS=300

# Frontend
PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
