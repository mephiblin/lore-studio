# PostgreSQL — Lore Studio 전용 DB/volume/network만 사용합니다.
POSTGRES_DB=lore_studio
POSTGRES_USER=lore
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql+psycopg://lore:change-this-local-password@db:5432/lore_studio

# API
APP_NAME=Lore Studio
APP_ENV=development
APP_CONFIG_ROOT=/app/config
APP_BIND_ADDRESS=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.200.103:5173
BACKEND_HOST_PORT=18000
FRONTEND_HOST_PORT=5173

# 실제 로컬 OpenAI 호환 모델. 모델 ID는 /v1/models의 값과 일치시킵니다.
WRITER_MODEL_BASE_URL=http://host.docker.internal:18093/v1
WRITER_MODEL_API_KEY=EMPTY
WRITER_MODEL_NAME=gemma4-26b-heretic-mtp
WRITER_MODEL_TIMEOUT_SECONDS=600
WRITER_CONTEXT_BUDGET=60000
WRITER_DISABLE_THINKING=false

UTILITY_MODEL_BASE_URL=http://host.docker.internal:18091/v1
UTILITY_MODEL_API_KEY=EMPTY
UTILITY_MODEL_NAME=qwen36-heretic-mtp
UTILITY_MODEL_TIMEOUT_SECONDS=600
UTILITY_CONTEXT_BUDGET=24000
UTILITY_DISABLE_THINKING=true

VISION_MODEL_BASE_URL=http://host.docker.internal:18091/v1
VISION_MODEL_API_KEY=EMPTY
VISION_MODEL_NAME=qwen36-heretic-mtp
VISION_MODEL_TIMEOUT_SECONDS=300
VISION_CONTEXT_BUDGET=24000
VISION_DISABLE_THINKING=true

# 자료 양산과 본문 AI의 모델 선택은 역할 재배정과 별개로 이 두 vLLM에 고정합니다.
QWEN_SELECTABLE_MODEL_BASE_URL=http://host.docker.internal:18091/v1
QWEN_SELECTABLE_MODEL_API_KEY=EMPTY
QWEN_SELECTABLE_MODEL_NAME=qwen36-heretic-mtp
QWEN_SELECTABLE_MODEL_TIMEOUT_SECONDS=600
QWEN_SELECTABLE_CONTEXT_BUDGET=24000
QWEN_SELECTABLE_DISABLE_THINKING=true
GEMMA_SELECTABLE_MODEL_BASE_URL=http://host.docker.internal:18093/v1
GEMMA_SELECTABLE_MODEL_API_KEY=EMPTY
GEMMA_SELECTABLE_MODEL_NAME=gemma4-26b-heretic-mtp
GEMMA_SELECTABLE_MODEL_TIMEOUT_SECONDS=600
GEMMA_SELECTABLE_CONTEXT_BUDGET=24000
GEMMA_SELECTABLE_DISABLE_THINKING=false

# Utility 실패 시 Writer 제한 fallback. 별도 fallback 서버가 있으면 아래 값을 사용합니다.
ALLOW_UTILITY_WRITER_FALLBACK=true
FALLBACK_MODEL_BASE_URL=
FALLBACK_MODEL_API_KEY=local
FALLBACK_MODEL_NAME=
FALLBACK_MODEL_TIMEOUT_SECONDS=300

# Lore Studio 전용 인덱스. 추론 endpoint만 공유하고 다른 프로젝트의 DB/캐시는 공유하지 않습니다.
EMBEDDING_ENABLED=true
EMBEDDING_PROVIDER=openai_compatible
# The server must bind 0.0.0.0 so the backend container can reach it.
EMBEDDING_BASE_URL=http://host.docker.internal:8010/v1
EMBEDDING_API_KEY=local
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_VERSION=bge-m3-v1
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=180

MODEL_RETRY_ATTEMPTS=2
ALLOW_MODEL_DOWNLOAD=false
LORE_STUDIO_MODEL_DIR=/models/lore-studio
FALLBACK_MODEL_HF_REPO=
FALLBACK_MODEL_HF_FILE=
FALLBACK_MMPROJ_HF_FILE=

# 실제 모델 통합 테스트는 명시적으로 실행할 때만 켭니다.
RUN_LOCAL_MODEL_TESTS=false
RUN_EMBEDDING_TESTS=false
RUN_VISION_TESTS=false

# Frontend
# 비워 두면 접속한 브라우저의 호스트 주소와 BACKEND_HOST_PORT를 사용합니다.
PUBLIC_API_BASE_URL=
