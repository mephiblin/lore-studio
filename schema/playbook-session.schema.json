{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlaybookSession",
  "type": "object",
  "required": [
    "project_id",
    "concept_slots",
    "writing_recipe_id",
    "settings_json"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "concept_slots": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "background": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "wildcards": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "direction_card_ids": {
      "description": "현재 프로젝트에 저장된 집필 지침(DirectionCard) ID 목록",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_direction": {
      "description": "이번 초안에만 적용하는 추가 지시",
      "type": "string"
    },
    "writing_recipe_id": {
      "description": "공용 기본 전개 방식 또는 현재 프로젝트 소유 전개 방식(WritingRecipe) ID",
      "type": "string"
    },
    "voice_profile_id": {
      "description": "승인된 공용 또는 현재 프로젝트 문체 프로필 ID. null이면 모델 기본 문체",
      "type": ["string", "null"]
    },
    "voice_selection_mode": {
      "enum": ["model_default", "profile_default", "manual", "retrieved"]
    },
    "voice_example_ids": {
      "description": "실제 생성 입력에 선택한 VoiceProfileExample ID 목록",
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string"}
    },
    "output_profile": {
      "description": "결과물 형태(Output Profile) key",
      "type": "string"
    },
    "settings_json": {
      "type": "object",
      "properties": {
        "length": {
          "enum": [
            "short",
            "normal",
            "long",
            "very_long",
            "custom"
          ]
        },
        "custom_length": {
          "description": "length가 custom일 때 사용하는 목표 한국어 글자 수",
          "type": ["integer", "null"],
          "minimum": 500
        },
        "detail_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "context_depth": {
          "description": "자동 관련 자료 검색 범위가 아니라 사용자가 선택한 자료의 본문 포함량. 선택 자료가 없으면 core로 비활성화",
          "enum": [
            "core",
            "balanced",
            "wide",
            "max"
          ]
        },
        "creativity": {
          "enum": [
            "strict",
            "conservative",
            "balanced",
            "free"
          ]
        },
        "viewpoint": {
          "enum": [
            "omniscient",
            "first_observer",
            "third_limited"
          ]
        },
        "tense": {
          "enum": [
            "present",
            "past"
          ]
        },
        "mystery_preservation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        }
      }
    },
    "seed": {
      "type": "integer"
    }
  }
}
