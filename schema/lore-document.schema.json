{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LoreDocument",
  "type": "object",
  "required": [
    "project_id",
    "title",
    "body_markdown",
    "final_body_markdown",
    "finalized_from_hash",
    "status"
  ],
  "properties": {
    "project_id": { "type": "string" },
    "session_id": { "type": ["string", "null"] },
    "title": { "type": "string" },
    "body_markdown": { "type": "string", "description": "초기 생성 시점의 초안 본문" },
    "body_json": { "type": "object" },
    "final_body_markdown": { "type": "string", "description": "초안 전체를 다시 다듬은 별도 완성본" },
    "finalized_from_hash": { "type": "string", "description": "완성본 생성에 사용한 현재 LoreBlock 조합의 SHA-256" },
    "finalized_at": { "type": ["string", "null"], "format": "date-time" },
    "status": { "enum": ["draft", "review", "approved", "archived"] }
  }
}
