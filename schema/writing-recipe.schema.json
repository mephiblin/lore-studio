{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WritingRecipe",
  "type": "object",
  "required": [
    "key",
    "version",
    "name",
    "pattern_preview",
    "required_moves",
    "moves",
    "planner_rules",
    "audit_rules"
  ],
  "properties": {
    "key": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "project_id": {
      "description": "null이면 공용 기본 방식, 문자열이면 해당 프로젝트 소유 방식",
      "type": [
        "string",
        "null"
      ]
    },
    "best_for": {
      "type": "string"
    },
    "pattern_preview": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "moves": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        }
      }
    },
    "required_moves": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "optional_moves": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "planner_rules": {
      "type": "array",
      "items": {
        "type": [
          "string",
          "object"
        ]
      }
    },
    "style_defaults": {
      "type": "object"
    },
    "audit_rules": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
